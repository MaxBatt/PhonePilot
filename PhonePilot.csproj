<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PhonePilot.ico</ApplicationIcon>
    <AssemblyName>PhonePilot</AssemblyName>
    <RootNamespace>PhonePilot</RootNamespace>
    <Title>PhonePilot</Title>
    <Product>PhonePilot</Product>
    <Description>Android-Smartphones über WLAN verwalten und fernsteuern</Description>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs;tests\**\*.cs" />
    <EmbeddedResource Remove="src\**\*;tests\**\*" />
    <None Remove="src\**\*;tests\**\*" />
    <ProjectReference Include="src\PhonePilot.Core\PhonePilot.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <Resource Include="Assets\PhonePilot.ico" />
    <Resource Include="Assets\PhonePilot.png" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyDevelopmentTools" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <DevelopmentAdb Include="$(ProjectDir)adb\**\*" />
      <DevelopmentScrcpy Include="$(ProjectDir)scrcpy\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DevelopmentAdb)" DestinationFiles="@(DevelopmentAdb->'$(TargetDir)adb\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DevelopmentScrcpy)" DestinationFiles="@(DevelopmentScrcpy->'$(TargetDir)scrcpy\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPortableTools" AfterTargets="Publish">

    <ItemGroup>
      <AdbFiles Include="$(ProjectDir)adb\**\*" />
      <ScrcpyFiles Include="$(ProjectDir)scrcpy\**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(AdbFiles)"
      DestinationFiles="@(AdbFiles->'$(PublishDir)adb\%(RecursiveDir)%(Filename)%(Extension)')" />

    <Copy
      SourceFiles="@(ScrcpyFiles)"
      DestinationFiles="@(ScrcpyFiles->'$(PublishDir)scrcpy\%(RecursiveDir)%(Filename)%(Extension)')" />

  </Target>

</Project>
