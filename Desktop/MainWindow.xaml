<Window x:Class="PhonePilot.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhonePilot" Icon="/Assets/PhonePilot.ico" Style="{StaticResource {x:Type Window}}" Width="1440" Height="940" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/PhonePilot.png" Width="42" Height="42" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="PhonePilot"/><StackPanel><TextBlock Text="PhonePilot" FontSize="20" FontWeight="Bold"/><TextBlock Text="Android-Geräte per WLAN verwalten" Style="{StaticResource Muted}"/></StackPanel></StackPanel>
        <DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="⚙" FontSize="21" Padding="13,5" Margin="14,0,0,0" Click="SettingsClick" ToolTip="Allgemeine Einstellungen" AutomationProperties.Name="Allgemeine Einstellungen"/><WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="⟳  Aktualisieren" Command="{Binding RefreshCommand}" Margin="0,3,8,3"/>
          <Button Content="↔  Alle verbinden" Command="{Binding AllConnectCommand}" Margin="0,3,8,3"/>
          <Button Content="▶  Alle starten" Command="{Binding AllStartCommand}" Margin="0,3,8,3"/>
          <Button Content="■  Alle stoppen" Command="{Binding AllStopCommand}" Margin="0,3,0,3"/>
        </WrapPanel></DockPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource WarningSurfaceBrush}" Padding="16,10" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
      <DockPanel><Button DockPanel.Dock="Right" Content="Schließen" Click="DismissNotice" Padding="10,4" MinHeight="28"/><Button DockPanel.Dock="Right" Content="Konfiguration wiederherstellen…" Click="RecoverClick" Margin="8,0" Visibility="{Binding RecoveryNeeded, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Notice}" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
    </Border>
    <Grid Grid.Row="2" Margin="12,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="285" MinWidth="230" MaxWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Margin="0,16,12,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="8,0,0,14"><Button DockPanel.Dock="Right" Content="＋ Hinzufügen" Click="AddClick" Padding="10,7"/><TextBlock Text="{Binding DeviceCount}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="Geräte">
          <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource MutedBrush}" BorderThickness="2" CornerRadius="5" Width="25" Height="47" VerticalAlignment="Center"><TextBlock Text="·" FontSize="20" HorizontalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Serial}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
              <StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding AdbBrush}" Width="9" Height="9" Margin="0,0,7,0"/><TextBlock Text="{Binding AdbText, StringFormat=ADB: {0}}" FontSize="12"/></StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Fill="{Binding SessionBrush}" Width="9" Height="9" Margin="0,0,7,0"/><TextBlock Text="{Binding SessionText, StringFormat=scrcpy: {0}}" FontSize="12"/></StackPanel>
            </StackPanel>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,12"><TextBlock Text="{Binding SessionCount}" Style="{StaticResource Muted}"/></Border>
      </Grid>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
      <Grid Grid.Column="2" Margin="18,16,4,12">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430" Visibility="{Binding NoDevices, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Willkommen bei PhonePilot" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Aktiviere WLAN-Debugging am Smartphone und verbinde beide Geräte mit demselben Netzwerk. Bereits gekoppelte Geräte werden automatisch gesucht." TextAlignment="Center" Margin="0,18"/><Button Content="＋ Gerät hinzufügen" Click="AddClick" Style="{StaticResource PrimaryButton}"/><Button Content="⟳ Erneut suchen" Command="{Binding RefreshCommand}" Margin="0,10,0,0"/></StackPanel>
        <Grid DataContext="{Binding SelectedDevice}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="8,0,0,20"><Border DockPanel.Dock="Right" Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="18,12" VerticalAlignment="Top"><TextBlock Text="{Binding Badge}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/></Border><StackPanel><TextBlock Text="{Binding Name}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,6"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Serial, StringFormat=Seriennummer: {0}}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button Content="⧉" Click="CopySerialClick" Padding="8,2" MinHeight="25" Margin="8,0,0,0" ToolTip="Seriennummer kopieren"/></StackPanel></StackPanel></DockPanel>
          <Border Grid.Row="1" Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"/></Border>
          <TabControl x:Name="DeviceTabs" Grid.Row="2">
            <TabItem Header="Steuerung"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,8,0">
              <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="⟳" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,4" ToolTip="Gerätestatus aktualisieren"/><TextBlock Text="Verbindungsstatus" Style="{StaticResource Heading}"/></DockPanel>
                <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="WLAN (mDNS)" Margin="0,8"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,8"><Ellipse Fill="{Binding MdnsBrush}" Width="10" Height="10" Margin="0,0,10,0"/><TextBlock Text="{Binding MdnsText}"/></StackPanel>
                  <TextBlock Grid.Row="1" Text="ADB" Margin="0,8"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8"><Ellipse Fill="{Binding AdbBrush}" Width="10" Height="10" Margin="0,0,10,0"/><TextBlock Text="{Binding AdbText}"/></StackPanel>
                  <TextBlock Grid.Row="2" Text="scrcpy" Margin="0,8"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8"><Ellipse Fill="{Binding SessionBrush}" Width="10" Height="10" Margin="0,0,10,0"/><TextBlock Text="{Binding SessionText}"/></StackPanel>
                </Grid><Button Content="↗  scrcpy-Fenster anzeigen" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stream-Einstellungen" Style="{StaticResource Heading}"/>
                <WrapPanel Margin="0,0,0,18"><TextBlock Text="Leistungsprofil" Width="160" VerticalAlignment="Center"/><ComboBox Width="260" ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Preset}"/></WrapPanel>
                <WrapPanel>
                  <StackPanel Width="175" Margin="0,0,14,12"><TextBlock Text="Maximale Bildkante (px)" Margin="0,0,0,6"/><ComboBox IsEditable="True" ItemsSource="{Binding DataContext.Sizes, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding MaxSize, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/></StackPanel>
                  <StackPanel Width="170" Margin="0,0,14,12"><TextBlock Text="Video-Bitrate (Mbit/s)" Margin="0,0,0,6"/><TextBox Text="{Binding BitRate, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/></StackPanel>
                  <StackPanel Width="150" Margin="0,0,14,12"><TextBlock Text="FPS-Limit" Margin="0,0,0,6"/><ComboBox IsEditable="True" ItemsSource="{Binding DataContext.FpsValues, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding MaxFps, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/></StackPanel>
                  <StackPanel Width="150" Margin="0,0,0,12"><TextBlock Text="Video-Codec" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding DataContext.Codecs, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Codec}"/></StackPanel>
                </WrapPanel><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,16"/>
                <TextBlock Text="Schnelloptionen" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel><CheckBox Content="Display am Handy ausschalten" IsChecked="{Binding ScreenOff}"/><CheckBox Content="Audio übertragen" IsChecked="{Binding Audio}"/><CheckBox Content="Immer im Vordergrund" IsChecked="{Binding OnTop}"/></WrapPanel>
                <Button Content="Weitere Optionen unter Einstellungen →" Click="DeviceSettingsClick" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Padding="0,8"/>
                <TextBlock Text="{Binding ChangesHint}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
              </StackPanel></Border>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Einstellungen"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,8,0">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gerät" Style="{StaticResource Heading}"/><TextBlock Text="Anzeigename" Margin="0,0,0,6"/><TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" MaxWidth="480" HorizontalAlignment="Left" MinWidth="240"/><TextBlock Text="{Binding Serial, StringFormat=Seriennummer: {0}}" Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="scrcpy-Fenster" Style="{StaticResource Heading}"/><WrapPanel><CheckBox Content="Im Vollbild starten" IsChecked="{Binding Fullscreen}"/><CheckBox Content="Fenster ohne Rahmen" IsChecked="{Binding Borderless}"/></WrapPanel><TextBlock Text="Eigener Fenstertitel (optional)" Margin="0,10,0,6"/><TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" MaxWidth="480" HorizontalAlignment="Left" MinWidth="240"/><TextBlock Text="Leer lassen, um den Anzeigenamen zu verwenden. Fensteroptionen gelten beim nächsten Start." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Wiederverbindung" Style="{StaticResource Heading}"/><CheckBox Content="ADB nach WLAN-Abbruch erneut verbinden" IsChecked="{Binding Reconnect}"/><TextBlock Text="Nach bewusstem Trennen bleibt die Verbindung getrennt. scrcpy wird nach einem Abbruch manuell gestartet." Style="{StaticResource Muted}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gerät verwalten" Style="{StaticResource Heading}"/><TextBlock Text="Gespeicherten Eintrag und Geräteeinstellungen entfernen. Die Kopplung mit diesem PC bleibt bestehen." Style="{StaticResource Muted}"/><Button Content="Gerät vergessen…" Click="ForgetClick" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel></Border>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Erweitert"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,8,0">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Erweiterte Stream-Optionen" Style="{StaticResource Heading}"/><WrapPanel><StackPanel Width="260" Margin="0,0,20,14"><TextBlock Text="Video-Encoder" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding Encoder}"/><Button Content="Encoder ermitteln" Margin="0,8,0,0" Command="{Binding DataContext.EncodersCommand, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel><StackPanel Width="220"><TextBlock Text="Bildausrichtung" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding DataContext.Orientations, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Orientation}"/></StackPanel></WrapPanel><TextBlock Text="Änderungen gelten beim nächsten Start. Die Bildausrichtung betrifft das scrcpy-Fenster. Nach einem Codecwechsel den Encoder erneut ermitteln oder Automatisch wählen." Style="{StaticResource Muted}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gerätediagnose" Style="{StaticResource Heading}"/><WrapPanel><Button Content="Verbindung prüfen" Command="{Binding DataContext.DiagnoseCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,8"/><Button Content="Geräteinformationen lesen" Command="{Binding DataContext.InformationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8"/><Button Content="Ergebnisse in Logs anzeigen →" Click="LogsClick" BorderThickness="0" Foreground="{DynamicResource AccentBrush}"/></WrapPanel></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Mitgelieferte Werkzeuge" Style="{StaticResource Heading}"/><TextBlock x:Name="ToolsText" Text="ADB und scrcpy aus den lokalen Werkzeugordnern" Style="{StaticResource Muted}"/><Button Content="Werkzeugordner öffnen" Click="OpenToolsClick" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Background="{DynamicResource WarningSurfaceBrush}"><StackPanel><TextBlock Text="ADB-Server neu starten" Style="{StaticResource Heading}"/><TextBlock Text="Betrifft alle ADB-Verbindungen auf diesem PC und kann laufende Sitzungen unterbrechen."/><Button Content="Neu starten…" Click="RestartAdbClick" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel></Border>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Logs"><Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,14,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <WrapPanel Margin="0,0,0,10"><StackPanel Width="170" Margin="0,0,10,8"><TextBlock Text="Bereich" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding LogScope}"/></StackPanel><StackPanel Width="150" Margin="0,0,10,8"><TextBlock Text="Quelle" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding LogSource}"/></StackPanel><StackPanel Width="180" Margin="0,0,10,8"><TextBlock Text="Level" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding LogLevel}"/></StackPanel><StackPanel Width="200" Margin="0,0,0,8"><TextBlock Text="Suche" Margin="0,0,0,6"/><TextBox Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Logs durchsuchen"/></StackPanel></WrapPanel>
              <WrapPanel Grid.Row="1" Margin="0,0,0,10"><CheckBox Content="Automatisch scrollen" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center"/><Button Content="Kopieren" Click="CopyLogsClick" Margin="0,0,8,0"/><Button Content="Exportieren…" Click="ExportLogsClick" Margin="0,0,8,0"/><Button Content="Ansicht leeren" Click="ClearLogsClick"/></WrapPanel>
              <DataGrid x:Name="LogGrid" Grid.Row="2" ItemsSource="{Binding LogView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" FontFamily="Consolas" FontSize="12" SelectionUnit="FullRow" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Zeit" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="82"/><DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="65"/><DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="85"/><DataGridTextColumn Header="Meldung" Binding="{Binding DisplayMessage}" Width="*" MinWidth="200"/></DataGrid.Columns></DataGrid>
              <TextBlock Grid.Row="3" Text="{Binding LogCount}" Style="{StaticResource Muted}" Margin="0,10"/>
            </Grid></TabItem>
          </TabControl>
          <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="▶  Starten" MinWidth="145" Margin="0,0,10,5" Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="■  Stoppen" MinWidth="145" Margin="0,0,10,5" Style="{StaticResource DangerButton}" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="↔  Verbinden" MinWidth="180" Margin="0,0,0,5" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowConnect, Converter={StaticResource BoolVisibility}}"/>
            <Button Content="Verbindung trennen" MinWidth="180" Margin="0,0,0,5" Click="DisconnectClick" Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolVisibility}}"/>
          </WrapPanel>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Padding="20,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdated}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Muted}" Margin="0,0,20,0"/></DockPanel></Border>
  </Grid>
</Window>
